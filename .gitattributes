# Store tabular files in Git LFS
*.csv  filter=lfs diff=lfs merge=lfs -text
*.tsv  filter=lfs diff=lfs merge=lfs -text
*.xls  filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text

# --- Linguist hints for GitHub language bar ---

# CSV / TSV
*.csv  linguist-detectable=true linguist-language=CSV
*.tsv  linguist-detectable=true linguist-language=TSV

# Excel
*.xls  linguist-detectable=true linguist-language=Excel
*.xlsx linguist-detectable=true linguist-language=Excel
